/*
  # 1. Clickjacking Protection
  X-Frame-Options: DENY
  
  # 2. MIME Sniffing Protection
  X-Content-Type-Options: nosniff
  
  # 3. Referrer Privacy
  Referrer-Policy: strict-origin-when-cross-origin
  
  # 4. HSTS (Enforce HTTPS)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # 5. Restrict Browser Features / Device Access
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
  
  # 6. Content Security Policy (Tailored to EduGuard's CDNs & Render Backend)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://eduguard-2xfk.onrender.com; frame-ancestors 'none';
